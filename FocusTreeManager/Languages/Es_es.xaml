    <system:String x:Key="Event_Description_Script">Script</system:String>
    <system:String x:Key="Event_Major">¿Es un evento importante?</system:String>
    <system:String x:Key="Event_Major_Tooltip">Los eventos importantes se muestran a todos los países.</system:String>
    <system:String x:Key="Event_Triggered">¿El evento solo se activa por script?</system:String>
    <system:String x:Key="Event_Triggered_Tooltip">Los eventos que solo se activan por script no pueden tener tiempo medio hasta su aparición: solo los lanza otro script con el comando event = id.</system:String>
    <system:String x:Key="Event_Hidden">¿Ocultar el evento al jugador?</system:String>
    <system:String x:Key="Event_Hidden_Tooltip">Los eventos ocultos no se muestran al jugador. No hace falta localizarlos.</system:String>
    <system:String x:Key="Event_Fired_Once">¿El evento se activa solo una vez?</system:String>
    <system:String x:Key="Event_Fired_Once_Tooltip">Los eventos que se activan solo una vez no se pueden lanzar de nuevo.</system:String>
