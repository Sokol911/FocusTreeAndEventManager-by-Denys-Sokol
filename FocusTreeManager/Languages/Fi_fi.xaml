    <system:String x:Key="Focus_X_Tooltip">Vaakasijainti ruudukossa. Sijainti voi olla suhteessa emoon; tarkista suhteelliset sijaintiviivat ALT-näppäimellä tai ruudukon kontekstivalikosta.</system:String>
    <system:String x:Key="Focus_Y">Pystysijainti (Y)</system:String>
    <system:String x:Key="Focus_Y_Tooltip">Pystysijainti ruudukossa. Sijainti voi olla suhteessa emoon; tarkista suhteelliset sijaintiviivat ALT-näppäimellä tai ruudukon kontekstivalikosta.</system:String>
