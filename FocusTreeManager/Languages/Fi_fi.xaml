    <system:String x:Key="Focus_Text">Lokalisoinnin tekstitunnus</system:String>
    <system:String x:Key="Focus_Text_Tooltip">Tekstiä voi käyttää tämän fokuksen lokalisointiin. Jos Text on määritetty, peli etsii sen avulla lokalisointiavainta, muuten se käyttää yksilöllistä nimeä.</system:String>
